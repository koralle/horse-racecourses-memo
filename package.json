    "@resvg/resvg-js": "catalog:",
    "astro": "catalog:",
    "clsx": "catalog:",
    "satori": "catalog:",
    "sharp": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/cloudflare": "catalog:",
    "@astrojs/compiler-rs": "catalog:",
    "@astrojs/language-server": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "pagefind": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@12.14.0"
}
